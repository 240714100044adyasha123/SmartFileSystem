# ==============================================================================
# SMARTFILE CLOUD OS — ENVIRONMENT TEMPLATE (.env.example)
# Duplicate this file as .env and replace placeholders with your AWS resources.
# ==============================================================================

# AWS REGIONAL SETTINGS
AWS_REGION=ap-south-1
AWS_DEFAULT_REGION=ap-south-1
ENVIRONMENT=production

# AWS IAM ACCESS CREDENTIALS
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID_HERE
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY_HERE
AWS_SESSION_TOKEN=

# AMAZON COGNITO
COGNITO_DOMAIN=https://<your-cognito-domain>.auth.<region>.amazoncognito.com
COGNITO_CLIENT_ID=<your-cognito-app-client-id>
COGNITO_USER_POOL_ID=<your-cognito-user-pool-id>
COGNITO_OAUTH_SCOPES=openid email phone
REDIRECT_URI=http://localhost:5500/index.html

# AMAZON API GATEWAY
API_GATEWAY_BASE_URL=https://<api-id>.execute-api.<region>.amazonaws.com
API_GATEWAY_URL=https://<api-id>.execute-api.<region>.amazonaws.com/upload-url

# AMAZON S3
S3_BUCKET_NAME=smart-event-file-processing-adyasha-2026
S3_UPLOAD_PREFIX=uploads/
MAX_FILE_SIZE_BYTES=10485760
PRESIGNED_URL_EXPIRATION_SECONDS=300

# AWS LAMBDA
LAMBDA_FUNCTION_NAME=SmartFileProcessor
LAMBDA_UPLOAD_FUNCTION=SmartFileUploadUrl
LAMBDA_HANDLER=lambda_function.lambda_handler
LAMBDA_RUNTIME=python3.14

# AMAZON DYNAMODB
DYNAMODB_TABLE=SmartFileProcessorRecords
DYNAMODB_PARTITION_KEY=file_id

# AMAZON SNS
SNS_TOPIC_ARN=arn:aws:sns:ap-south-1:093047596206:SmartFileNotifications
SNS_TOPIC_NAME=SmartFileNotifications

# AMAZON EC2 SERVER
HOST=0.0.0.0
PORT=5500
EC2_PUBLIC_HOST=localhost

# DEMO / SIMULATION MODE
SMARTFILE_DEMO_MODE=false

